digraph music_processing_flow {
    graph [
        bgcolor="white",
        fontname="Helvetica",
        fontsize=18,
        label="Music Processing CLI dispatch branch patterns (main.py)",
        labelloc="t",
        nodesep=0.4,
        rankdir=TB,
        ranksep=0.55,
        splines=polyline
    ];

    node [
        color="#334155",
        fillcolor="#F8FAFC",
        fontname="Helvetica",
        fontsize=10,
        margin="0.14,0.09",
        penwidth=1.2,
        shape=box,
        style="rounded,filled"
    ];

    edge [
        color="#475569",
        fontname="Helvetica",
        fontsize=9,
        penwidth=1.1
    ];

    start [fillcolor="#DCFCE7", label="Start main.py"];
    entry [label="Create parser and register subcommands"];
    parse [label="Parse and validate selected subcommand arguments"];
    dispatch [fillcolor="#DBEAFE", label="main(args): evaluate dispatch branches"];
    exception [color="#B91C1C", fillcolor="#FEE2E2", label="Log exception"];
    end [fillcolor="#E2E8F0", label="End", shape=oval];

    start -> entry -> parse -> dispatch;
    entry -> exception [label="exception", style=dashed];
    parse -> exception [label="exception", style=dashed];
    dispatch -> exception [label="exception", style=dashed];
    exception -> end;

    subgraph cluster_patterns {
        color="#94A3B8";
        fontname="Helvetica";
        fontsize=13;
        label="Unique if-branch patterns";
        style="rounded";

        single_file_branch [fillcolor="#FEF3C7", label="if args.subcommand is one of:\nconvert-file, ebu-file, extract-file,\nget-ffprobe-media-info, get-ffprobe-media-tags,\nnormalize-{flac,mp3,mp4,wma}-filename,\npeak-file, rms-file"];
        single_file_action [label="file_path = getattr(args, 'file')\nCall matching handler(file_path)"];

        mutagen_branch [fillcolor="#FEF3C7", label="if args.subcommand ==\n'get-mutagen-tags'"];
        mutagen_action [label="file_path = getattr(args, 'file')\ntags = get_mutagen_tags(file_path)\nPretty-print tags.pprint().splitlines()"];

        single_tld_branch [fillcolor="#FEF3C7", label="if args.subcommand is one of:\ncreate-albums, get-unique-media, list-audio,\nnormalize-{flac,mp3,mp4,wma}-filename-walk,\nremove-albums, set-album-art, update-walk"];
        single_tld_action [label="tld_path = getattr(args, 'tld')\nCall matching handler(tld_path)"];

        optional_pattern_branch [fillcolor="#FEF3C7", label="if args.subcommand is one of:\nconvert-walk, extract-walk,\nget-ffprobe-media-info-walk"];
        optional_pattern_action [label="tld_path = getattr(args, 'tld')\nfile_pattern = getattr(args, 'pattern')\nCall matching handler(tld_path, file_pattern)"];

        tags_walk_branch [fillcolor="#FEF3C7", label="if args.subcommand ==\n'get-tags-walk'"];
        tags_walk_action [label="tld_path = getattr(args, 'tld')\nfile_pattern = getattr(args, 'pattern')\nffprobe = getattr(args, 'ffprobe')\nget_tags_walk(tld_path, file_pattern, ffprobe)"];

        list_type_branch [fillcolor="#FEF3C7", label="if args.subcommand ==\n'list-type'"];
        list_type_action [label="tld_path = getattr(args, 'tld')\nfile_ext = getattr(args, 'ext')\nlist_type(tld_path, file_ext)"];

        two_required_branch [fillcolor="#FEF3C7", label="if args.subcommand is one of:\nlevel-normalize-walk, remove-pattern, update-m3u"];
        two_required_action [label="Get tld_path and the command-specific\nrequired argument: type, pattern, or m3u\nCall matching handler(tld_path, required_argument)"];

        { rank=same; single_file_branch; mutagen_branch; single_tld_branch; }
        { rank=same; optional_pattern_branch; tags_walk_branch; list_type_branch; }

        single_file_branch -> single_file_action;
        mutagen_branch -> mutagen_action;
        single_tld_branch -> single_tld_action;
        optional_pattern_branch -> optional_pattern_action;
        tags_walk_branch -> tags_walk_action;
        list_type_branch -> list_type_action;
        two_required_branch -> two_required_action;
    }

    dispatch -> single_file_branch;
    dispatch -> mutagen_branch;
    dispatch -> single_tld_branch;
    dispatch -> optional_pattern_branch;
    dispatch -> tags_walk_branch;
    dispatch -> list_type_branch;
    dispatch -> two_required_branch;

    single_file_action -> end;
    mutagen_action -> end;
    single_tld_action -> end;
    optional_pattern_action -> end;
    tags_walk_action -> end;
    list_type_action -> end;
    two_required_action -> end;
}
