    "version": "0.2.0",
    "configurations": [
        // for debuging C:\Users\gmanw\AppData\Local\Programs\Python\Python312\Lib\site-packages\ffmpeg_normalize\
        // with cli args
        {
            "name": "Python Debugger: Module with Arguments",
            "type": "debugpy",
            "request": "launch",
            "args": "${command:pickArgs}",
            "env": {"PYTHONPATH":"${workspaceRoot}"},
            "module": "ffmpeg_normalize",
            "stopOnEntry": true,
            "justMyCode": false
        }
    ]
}