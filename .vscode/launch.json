{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // just like it says, no option for input arguments though
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        // really meant for entering command-line arguments for the CLI version of MusicProcessing,
        // BUT you can enter the "gui" argument here if you want to launch the GUI from the CLI configuration
        {
            "name": "Python Debugger: MusicProcessing CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": "${command:pickArgs}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        // the environment variable MUSICPROCESSING_GUI_DISPLAY sets the display location
        // the main GUI app code is coupled to this environment variable
        {
            "name": "Python Debugger: MusicProcessing GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "gui"
            ],
            "env": {
                "MUSICPROCESSING_GUI_DISPLAY": "lower-left"
            },
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}